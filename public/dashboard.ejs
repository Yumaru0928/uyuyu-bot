<!doctype html>
<html lang="ja">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <title>ダッシュボード | うゆゆBot</title>
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Noto+Sans+JP:wght@400;500;700&family=Zen+Maru+Gothic:wght@500;700;900&display=swap">
    <!-- 共通化したCSSを読み込み -->
    <link rel="stylesheet" href="style.css">
</head>

<body>
    <header class="top">
        <div class="top-in">
            <a class="brand" href="index.html">
                <img src="uyuyu.png" alt="" class="brand-logo">
                うゆゆBot
            </a>
            <nav class="nav" aria-label="メインメニュー">
                <a href="index.html">機能</a>
                <a href="terms.html">利用規約</a>
                <a href="privacy.html">プライバシー</a>
                <a href="credits.html">クレジット</a>
                <a href="invite.html" class="join">招待</a>
            </nav>
        </div>
    </header>

    <main class="wrap">
        <!-- 管理サーバー一覧画面 -->
        <section id="view-guilds">
            <h1 class="page-title">サーバーダッシュボード</h1>
            <p class="meta">管理権限を持っているDiscordサーバーを選択してください。</p>

            <div class="guild-grid" id="guild-list">
                <% guilds.forEach(guild=> { %>
                    <a href="/dashboard/<%= guild.id %>" class="guild-card">
                        <% if (guild.icon) { %>
                            <img src="https://cdn.discordapp.com/icons/<%= guild.id %>/<%= guild.icon %>.png" alt=""
                                class="guild-icon">
                            <% } else { %>
                                <div class="guild-icon">
                                    <%= guild.name.charAt(0) %>
                                </div>
                                <% } %>
                                    <div class="guild-info">
                                        <div class="guild-name">
                                            <%= guild.name %>
                                        </div>
                                        <div class="guild-status">管理可能</div>
                                    </div>
                    </a>
                    <% }) %>
            </div>
        </section>
    </main>

    <footer class="foot">
        <div class="foot-in">
            <nav aria-label="フッターメニュー">
                <a href="index.html">機能</a>
                <a href="terms.html">利用規約</a>
                <a href="privacy.html">プライバシー</a>
                <a href="credits.html">クレジット</a>
                <a href="https://github.com/Yumaru0928/uyuyu-bot">GitHub</a>
            </nav>
            <p>うゆゆBotは個人が運営するDiscord Botです。Discord Inc.とは関係のない非公式のBotです。</p>
            <p>&copy; 2026 ゆまる All rights reserved.</p>
        </div>
    </footer>
</body>

</html>