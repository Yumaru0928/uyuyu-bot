<!doctype html>
<html lang="ja">
<%- include('partials/head', { title: guild.name + ' の設定' }) %>

<%
  // Auto-React を無効にしているチャンネルのID
  const disabledReact = Array.isArray(guildConfig.disableAutoReact) ? guildConfig.disableAutoReact : [];
  const reactOnCount = channels.filter(c => !disabledReact.includes(c.id)).length;
  const deleteLogSet = channels.some(c => c.id === guildConfig.deleteLogChannel);

  // ハニーポット設定（未設定の項目は既定値で補う）
  const honeypot = Object.assign(
    { honeypotChannel: null, punishment: 'kick', autoDelete: true, logChannel: null },
    guildConfig.honeypot || {}
  );
  const honeypotSet = channels.some(c => c.id === honeypot.honeypotChannel);
  const punishmentOptions = [
    { value: 'kick', label: 'キック' },
    { value: 'ban', label: 'BAN' },
    { value: 'timeout', label: 'タイムアウト（28日間）' },
  ];

  // 左のタブ一覧（id は、右の各設定の section の id と揃える）。on は、タブ横の点の点灯（設定済みかどうか）
  const tabs = [
    { id: 'delete-log', label: '削除ログ', on: deleteLogSet },
    { id: 'auto-react', label: 'Auto-React', on: reactOnCount > 0 },
    { id: 'honeypot', label: 'ハニーポット', on: honeypotSet },
    { id: 'notifications', label: '配信・投稿の通知', on: notifications.length > 0 },
  ];
%>

<body class="dash">
    <div class="shell">
        <%- include('partials/sidebar', { tabs: tabs }) %>

        <main class="main">
            <header class="bar">
                <div class="bar-title">
                    <span class="glyph glyph--m">
                        <% if (guild.icon) { %><img src="https://cdn.discordapp.com/icons/<%= guild.id %>/<%= guild.icon %>.png?size=128" alt=""><% } else { %><%= Array.from(guild.name)[0] %><% } %>
                    </span>
                    <div>
                        <h1 class="page-title"><%= guild.name %> の設定</h1>
                    </div>
                </div>
                <%- include('partials/me') %>
            </header>

            <% if (query && query.saved) { %>
            <p class="alert" role="status">設定を保存しました。</p>
            <% } %>

            <form class="stack" action="/dashboard/<%= guildId %>" method="post">
                <input type="hidden" name="tab" id="activeTab" value="">

                <section class="panel" data-panel="delete-log" aria-labelledby="delete-log-title">
                    <div class="panel-head">
                        <div>
                            <h2 class="panel-title" id="delete-log-title">削除ログ</h2>
                            <p class="panel-lead">メッセージが削除されたときに、内容と削除した人を通知するチャンネルです。</p>
                        </div>
                        <span class="status<%= deleteLogSet ? '' : ' status--off' %>"><%= deleteLogSet ? '有効' : '未設定' %></span>
                    </div>
                    <div class="field">
                        <label class="field-label" for="deleteLogChannel">送信先チャンネル</label>
                        <select class="select" id="deleteLogChannel" name="deleteLogChannel">
                            <option value="">(未設定: 削除ログを送らない)</option>
                            <% channels.forEach(channel => { %>
                            <option value="<%= channel.id %>"<%= guildConfig.deleteLogChannel === channel.id ? ' selected' : '' %>>#<%= channel.name %></option>
                            <% }) %>
                        </select>
                        <p class="field-help">Botがそのチャンネルに送信できる権限を持っている必要があります。</p>
                    </div>
                </section>

                <section class="panel" data-panel="auto-react" aria-labelledby="auto-react-title">
                    <div class="panel-head">
                        <div>
                            <h2 class="panel-title" id="auto-react-title">Auto-React</h2>
                            <p class="panel-lead">「うゆゆ」などを含むメッセージに、うゆゆ絵文字を自動でつけます。つけたくないチャンネルはオフにしてください。</p>
                        </div>
                        <span class="status<%= reactOnCount ? '' : ' status--off' %>"><%= reactOnCount %> / <%= channels.length %> チャンネルで有効</span>
                    </div>
                    <% if (channels.length) { %>
                    <ul class="switch-list">
                        <% channels.forEach(channel => { %>
                        <li>
                            <label class="switch">
                                <input class="switch-input" type="checkbox" name="autoReact" value="<%= channel.id %>"<%= disabledReact.includes(channel.id) ? '' : ' checked' %>>
                                <span class="switch-name">#<%= channel.name %></span>
                            </label>
                        </li>
                        <% }) %>
                    </ul>
                    <% } else { %>
                    <p class="unset">Botが見られるテキストチャンネルがありません。</p>
                    <% } %>
                </section>

                <section class="panel" data-panel="honeypot" aria-labelledby="honeypot-title">
                    <div class="panel-head">
                        <div>
                            <h2 class="panel-title" id="honeypot-title">ハニーポット</h2>
                            <p class="panel-lead">このチャンネルに投稿したユーザーを自動で処罰します。荒らしやスパムBOTの対策に使えます。管理者・チャンネル管理権限を持つ人は対象外です。</p>
                        </div>
                        <span class="status<%= honeypotSet ? '' : ' status--off' %>"><%= honeypotSet ? '有効' : '未設定' %></span>
                    </div>

                    <div class="field">
                        <label class="field-label" for="honeypotChannel">ハニーポットチャンネル</label>
                        <select class="select" id="honeypotChannel" name="honeypotChannel">
                            <option value="">(未設定: ハニーポットを使わない)</option>
                            <% channels.forEach(channel => { %>
                            <option value="<%= channel.id %>"<%= honeypot.honeypotChannel === channel.id ? ' selected' : '' %>>#<%= channel.name %></option>
                            <% }) %>
                        </select>
                        <p class="field-help">誰も投稿しないチャンネルを指定してください。チャンネル内に注意書きを置くのがおすすめです。</p>
                    </div>

                    <div class="field">
                        <label class="field-label" for="honeypotPunishment">処罰</label>
                        <select class="select" id="honeypotPunishment" name="honeypotPunishment">
                            <% punishmentOptions.forEach(option => { %>
                            <option value="<%= option.value %>"<%= honeypot.punishment === option.value ? ' selected' : '' %>><%= option.label %></option>
                            <% }) %>
                        </select>
                        <p class="field-help">Botに該当の権限があり、Botのロールが対象ユーザーより上である必要があります。</p>
                    </div>

                    <div class="field">
                        <ul class="switch-list">
                            <li>
                                <label class="switch">
                                    <input class="switch-input" type="checkbox" name="honeypotAutoDelete" value="1"<%= honeypot.autoDelete ? ' checked' : '' %>>
                                    <span class="switch-name">メッセージを自動で削除する</span>
                                </label>
                            </li>
                        </ul>
                        <p class="field-help">有効にすると、投稿と、キック・BANは直近24時間分、タイムアウトは直近120分分のメッセージを全チャンネルから削除します。</p>
                    </div>

                    <div class="field">
                        <label class="field-label" for="honeypotLogChannel">ログチャンネル</label>
                        <select class="select" id="honeypotLogChannel" name="honeypotLogChannel">
                            <option value="">(未設定: ログを送らない)</option>
                            <% channels.forEach(channel => { %>
                            <option value="<%= channel.id %>"<%= honeypot.logChannel === channel.id ? ' selected' : '' %>>#<%= channel.name %></option>
                            <% }) %>
                        </select>
                        <p class="field-help">引っかかったユーザーの情報と処罰の結果を送信します。Botがそのチャンネルに送信できる権限を持っている必要があります。</p>
                    </div>
                </section>

                <div class="form-actions" data-save>
                    <button class="btn btn--primary" type="submit">変更を保存</button>
                    <a class="btn btn--ghost" href="/dashboard/<%= guildId %>">元に戻す</a>
                </div>
            </form>

            <section class="panel" data-panel="notifications" aria-labelledby="notify-title">
                <div class="panel-head">
                    <div>
                        <h2 class="panel-title" id="notify-title">配信・投稿の通知</h2>
                        <p class="panel-lead">YouTubeの新着動画・ライブ配信、Twitchの配信開始を、指定したチャンネルに通知します。追加と削除は、上の「変更を保存」を待たずにすぐ反映されます。</p>
                    </div>
                    <span class="status<%= notifications.length ? '' : ' status--off' %>"><%= notifications.length %> / <%= notifyMax %> 件</span>
                </div>

                <% if (notifyFlash) { %>
                <p class="alert<%= notifyFlash.type === 'error' ? ' alert--error' : '' %>" role="<%= notifyFlash.type === 'error' ? 'alert' : 'status' %>"><%= notifyFlash.text %></p>
                <% } %>

                <% if (notifications.length) { %>
                <ul class="notify-list">
                    <% notifications.forEach(item => {
                        const ch = channels.find(c => c.id === item.channelId);
                        const role = item.roleId === 'everyone' ? '@everyone' : (roles.find(r => r.id === item.roleId) || {}).name;
                    %>
                    <li class="notify-item">
                        <div class="notify-main">
                            <span class="chip"><%= notifyLabel(item.platform) %></span>
                            <strong><%= item.targetName %></strong>
                            <span class="notify-meta">→ <%= ch ? '#' + ch.name : '(削除されたチャンネル)' %><%= item.roleId ? ' / ' + (role ? (item.roleId === 'everyone' ? role : '@' + role) : '(削除されたロール)') : '' %></span>
                        </div>
                        <form action="/dashboard/<%= guildId %>/notifications" method="post">
                            <input type="hidden" name="action" value="remove">
                            <input type="hidden" name="id" value="<%= item.id %>">
                            <button class="btn btn--ghost" type="submit">削除</button>
                        </form>
                    </li>
                    <% }) %>
                </ul>
                <% } else { %>
                <p class="unset">まだ通知は登録されていません。</p>
                <% } %>

                <% if (notifications.length < notifyMax && channels.length) { %>
                <form class="notify-add" action="/dashboard/<%= guildId %>/notifications" method="post">
                    <input type="hidden" name="action" value="add">

                    <div class="field">
                        <label class="field-label" for="notifyPlatform">サービス</label>
                        <select class="select" id="notifyPlatform" name="platform" required>
                            <% notifyPlatforms.forEach(p => { %>
                            <option value="<%= p.id %>"<%= p.enabled ? '' : ' disabled' %>><%= p.label %><%= p.enabled ? '' : '（準備中・未設定）' %></option>
                            <% }) %>
                        </select>
                        <p class="field-help">YouTube：新しい動画・ライブ配信の作成 / Twitch：配信の開始</p>
                    </div>

                    <div class="field">
                        <label class="field-label" for="notifyTarget">通知する相手</label>
                        <input class="input" id="notifyTarget" name="target" type="text" maxlength="200" required
                            placeholder="YouTube: @ハンドル / チャンネルID（UC…）　Twitch: ユーザー名">
                    </div>

                    <div class="field">
                        <label class="field-label" for="notifyChannel">通知先チャンネル</label>
                        <select class="select" id="notifyChannel" name="channelId" required>
                            <% channels.forEach(channel => { %>
                            <option value="<%= channel.id %>">#<%= channel.name %></option>
                            <% }) %>
                        </select>
                        <p class="field-help">Botがそのチャンネルに送信できる権限を持っている必要があります。</p>
                    </div>

                    <div class="field">
                        <label class="field-label" for="notifyRole">メンションするロール</label>
                        <select class="select" id="notifyRole" name="roleId">
                            <option value="">(メンションしない)</option>
                            <option value="everyone">@everyone</option>
                            <% roles.forEach(role => { %>
                            <option value="<%= role.id %>">@<%= role.name %></option>
                            <% }) %>
                        </select>
                        <p class="field-help">@everyone や、メンション不可のロールを使うには、Botに「@everyone、@here、全てのロールにメンション」権限が必要です。</p>
                    </div>

                    <div class="form-actions">
                        <button class="btn btn--primary" type="submit">通知を追加</button>
                    </div>
                </form>
                <% } %>
            </section>
        </main>
    </div>
    <script>
    // 左のタブで、右に表示する設定を切り替える（JavaScript が使えないときは、すべて縦に並べて表示する）。
    // 各設定の section に id を付けないのは、#honeypot などで開いたときにブラウザが勝手にそこまでスクロールするのを避けるため。
    // 非表示にした設定の入力欄もフォームには残るので、どのタブで「変更を保存」を押しても全体が保存される
    (function () {
        var panels = Array.prototype.slice.call(document.querySelectorAll('[data-panel]'));
        var links = Array.prototype.slice.call(document.querySelectorAll('[data-tab]'));
        var actions = document.querySelector('[data-save]');
        var tabField = document.getElementById('activeTab');
        if (!panels.length) return;

        function show(id) {
            if (!panels.some(function (p) { return p.dataset.panel === id; })) id = panels[0].dataset.panel;
            panels.forEach(function (p) {
                p.hidden = p.dataset.panel !== id;
                // 「変更を保存」は、フォームの中にある設定のタブでだけ出す（通知は追加・削除がすぐ反映されるので不要）
                if (!p.hidden && actions) actions.hidden = !p.closest('form');
            });
            links.forEach(function (l) {
                if (l.dataset.tab === id) l.setAttribute('aria-current', 'page'); else l.removeAttribute('aria-current');
            });
            if (tabField) tabField.value = id; // 保存後に同じタブへ戻すため
        }

        links.forEach(function (link) {
            link.addEventListener('click', function (e) {
                e.preventDefault();
                history.replaceState(null, '', '#' + link.dataset.tab);
                show(link.dataset.tab);
            });
        });
        window.addEventListener('hashchange', function () { show(location.hash.slice(1)); });
        show(location.hash.slice(1));
    })();
    </script>
</body>

</html>
